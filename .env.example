# ==============================================
# Configuration centralisée - Calendrier Cloud
# ==============================================
# Copier ce fichier en .env et adapter les valeurs

# ============================================
# Base de données PostgreSQL
# ============================================
POSTGRES_USER=calendar_user
POSTGRES_PASSWORD=change_me_strong_password

# DB API Métier (Events)
POSTGRES_DB_METIER=events_db
DATABASE_URL_METIER=postgresql://calendar_user:change_me_strong_password@db-metier:5432/events_db

# DB API Utilisateur (Users)
POSTGRES_DB_USER=users_db
DATABASE_URL_USER=postgresql://calendar_user:change_me_strong_password@db-user:5432/users_db

# ============================================
# JWT Authentication (partagé entre les APIs)
# ============================================
SECRET_KEY=your_super_secret_jwt_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# API Configuration
# ============================================
API_METIER_URL=http://api-metier:3001
API_USER_URL=http://api-user:3000

# ============================================
# Ports
# ============================================
PORT_WEB=8080
PORT_API_USER=3000
PORT_API_METIER=3001

# ============================================
# Environment
# ============================================
DEBUG=0
PYTHONUNBUFFERED=1
