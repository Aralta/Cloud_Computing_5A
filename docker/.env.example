# ==============================================
# Configuration Docker - Calendrier Cloud
# ==============================================
# Copier ce fichier en .env et adapter les valeurs

# ============================================
# Base de données PostgreSQL
# ============================================
POSTGRES_USER=calendar_user
POSTGRES_PASSWORD=change_me_strong_password

# DB API Métier (Events)
POSTGRES_DB_METIER=events_db

# DB API Utilisateur (Users)
POSTGRES_DB_USER=users_db

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRATION=3600

# ============================================
# API Configuration
# ============================================
API_METIER_URL=http://api-metier:3001
API_USER_URL=http://api-user:3000

# ============================================
# Environment
# ============================================
# development | staging | production
NODE_ENV=development
DEBUG=0
